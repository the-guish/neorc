\n\ntype GraphFlowNode = Node<NodeData>;\n\n/** Show iteration `n` of the loop `loop` at `scope`; `latest` when it is the last so far. */\ntype Pick = (loop: string, scope: Scope, n: number, latest: boolean) => void;\n\n/** How a loop's node asks for another iteration: React Flow gives a node its data only. */\nconst PickContext = createContext<Pick>(() => {});\n\n/** The task whose details are open: a step, in the branches and iterations of `scope`. */\ninterface Selected {\n  step: string;\n  scope: Scope;\n}\n\n/**\n * Whether the graph is of a definition, with no run: its nodes then say\n * what a step is, and nothing of where a run stands on it.\n */\nconst DefinitionContext = createContext(false);\n\n/** What no run has done: a definition's graph is a run's with nothing published. */\nconst NOTHING_DONE = published([], []);\n\n/** A graph's nodes and edges as React Flow takes them, `selectedId` selected. */\nfunction useElements(\n  graph: Graph,\n  selectedId: string | null,\n): { nodes: GraphFlowNode[]; edges: Edge[] } {\n  const nodes = useMemo(\n    (): GraphFlowNode[] =>\n      graph.nodes.map((node) => ({\n        ...node,\n        selected: node.id === selectedId,\n        // The size the layout gave is the size drawn. Said here, React Flow\n        // has nothing to measure: it measures a node once, when it first\n        // draws it, and these are made anew whenever the graph changes, so\n        // without this \"fit view\" would wait for a measure that never comes.\n        measured: { width: node.width, height: node.height },\n        // Where edges attach, known from the sizes: React Flow measures the\n        // handles in the browser, and draws edges from these until then.\n        handles: [\n          { type: \"target\", position: Position.Top, x: node.width / 2, y: 0, width: 1, height: 1 },\n          {\n            type: \"source\",\n            position: Position.Bottom,\n            x: node.width / 2,\n            y: node.height,\n            width: 1,\n            height: 1,\n          },\n        ],\n        // A parent's box is drawn behind its children, not over them.\n        ...(node.type === \"container\" && { zIndex: -1 }),\n      })),\n    [graph, selectedId],\n  );\n  const edges = useMemo(\n    (): Edge[] =>\n      graph.edges.map((edge) => ({\n        id: edge.id,\n        source: edge.source,\n        target: edge.target,\n        type: \"smoothstep\",\n        markerEnd: { type: MarkerType.ArrowClosed },\n        ariaLabel: `${edge.source} feeds ${edge.target}`,\n      })),\n    [graph],\n  );\n  return { nodes, edges };\n}\n\n/** The canvas both graphs draw on: read-only, pan and zoom. */\nfunction Canvas({\n  nodes,\n  edges,\n  onNodeClick,\n  onPaneClick,\n  minimap = false,\n}: {\n  nodes: GraphFlowNode[];\n  edges: Edge[];\n  onNodeClick: (node: GraphFlowNode) => void;\n  onPaneClick: () => void;\n  minimap?: boolean;\n}) {\n  return (\n    <ReactFlow\n      nodes={nodes}\n      edges={edges}\n      nodeTypes={NODE_TYPES}\n      fitView\n      minZoom={0.05}\n      colorMode=\"system\"\n      nodesDraggable={false}\n      nodesConnectable={false}\n      nodesFocusable\n      edgesFocusable={false}\n      onNodeClick={(_, node) => onNodeClick(node)}\n      onPaneClick={onPaneClick}\n    >\n      <Background />\n      <Controls showInteractive={false} />\n      {minimap && <MiniMap pannable zoomable />}\n    </ReactFlow>\n  );\n}\n\n/**\n * A flow's steps as its definition has them, before any run: a node per\n * step, loops and fan-outs as boxes around them, edges from each step to\n * the ones reading it. How many times a loop goes round, and how many\n * branches a fan-out over a list has, only a run says: each is drawn once.\n * Read-only: pan and zoom, click a step for what it is given.\n */\nexport function FlowGraph({ steps }: { steps: StepNode[] }) {\n  const { href } = useNav();\n  const graph = useMemo(() => runGraph(steps, NOTHING_DONE), [steps]);\n  const [selectedId, setSelectedId] = useState<string | null>(null);\n  const selected = graph.nodes.find((node) => node.id === selectedId)?.data;\n  const { nodes, edges } = useElements(graph, selectedId);\n  // As tall as the steps need, within reason: what follows stays in reach.\n  const height = `clamp(15rem, ${Math.ceil(graph.height) + 96}px, 60vh)`;\n  return (\n    <div className=\"neorc-run-graph neorc-flow-graph\" style={{ height }}>\n      <div className=\"neorc-run-graph-canvas\" aria-label=\"Flow graph\">\n        <DefinitionContext value={true}>\n          <Canvas\n            nodes={nodes}\n            edges={edges}\n            onNodeClick={(node) => setSelectedId(node.data.kind === \"container\" ? null : node.id)}\n            onPaneClick={() => setSelectedId(null)}\n          />\n        </DefinitionContext>\n      </div>\n      {selected && selected.kind !== \"container\" && (\n        <aside className=\"neorc-run-graph-panel\" aria-label={`${selected.name} details`}>\n          <div className=\"neorc-run-graph-panel-head\">\n            <strong>{selected.name}</strong>\n            <button type=\"button\" onClick={() => setSelectedId(null)}>\n              Close\n            </button>\n          </div>\n          <dl className=\"neorc-facts\">\n            {selected.kind === \"task\" ? (\n              <>\n                <dt>Handler</dt>\n                <dd>\n                  <code>{selected.handler}</code> on <code>{selected.queue}</code>\n                </dd>\n              </>\n            ) : (\n              <>\n                <dt>Sub-flow</dt>\n                <dd>\n                  <a href={href({ name: \"flow\", flow: selected.flow })}>{selected.flow}</a>, its\n                  latest version\n                </dd>\n              </>\n            )}\n          </dl>\n          {Object.keys(selected.params).length > 0 && (\n            <>\n              <h4>Params</h4>\n              <pre>{formatValue(selected.params)}</pre>\n            </>\n          )}\n          {selected.kind === \"task\" && Object.keys(selected.fixedParams).length > 0 && (\n            <>\n              <h4>Fixed params</h4>\n              <pre>{formatValue(selected.fixedParams)}</pre>\n            </>\n          )}\n        </aside>\n      )}\n    </div>\n  );\n}\n\n/**\n * The run's steps as a graph: a node per step, loops and a fan-out's\n * branches as boxes around them, edges from each step to the ones reading\n * it. A loop is one box, showing its latest iteration until another is\n * picked on it. Read-only: pan and zoom, click a task for its details.\n */\nexport function RunGraph({ steps, done }: { steps: StepNode[]; done: Published }) {\n  const [picked, setPicked] = useState<Picked>(() => new Map());\n  // The poll gives new tasks and sub-runs only when something changed, so\n  // the layout is redone only then, or when another iteration is picked.\n  const graph = useMemo(() => runGraph(steps, done, picked), [steps, done, picked]);\n  const [chosen, setChosen] = useState<Selected | null>(null);\n  const selectedId = chosen && stepNodeId(chosen.step, chosen.scope);\n  const selected = graph.nodes.find((node) => node.id === selectedId)?.data;\n  const pick = useCallback<Pick>((loop, scope, n, latest) => {\n    setPicked((before) => {\n      const after = new Map(before);\n      // The latest is not pinned: a live run's loop goes on to its next.\n      if (latest) after.delete(loopKey(loop, scope));\n      else after.set(loopKey(loop, scope), n);\n      return after;\n    });\n    // Details open on a step of the loop follow it to the iteration picked.\n    setChosen((before) => {\n      const at = before?.scope[scope.length];\n      const within =\n        before &&\n        at?.[0] === loop &&\n        scope.every(([name, m], i) => before.scope[i]?.[0] === name && before.scope[i]?.[1] === m);\n      if (!within) return before;\n      const moved: Scope = [...scope, [loop, n], ...before.scope.slice(scope.length + 1)];\n      return { step: before.step, scope: moved };\n    });\n  }, []);\n  const { nodes, edges } = useElements(graph, selectedId);\n\n  return (\n    <div className=\"neorc-run-graph\">\n      <div className=\"neorc-run-graph-canvas\" aria-label=\"Run graph\">\n        <PickContext value={pick}>\n          <Canvas\n            nodes={nodes}\n            edges={edges}\n            minimap\n            onNodeClick={(node) => {\n              // A click on a loop's controls picks an iteration, and leaves the details be.\n              if (node.data.kind === \"container\") return;\n              const task = node.data.kind === \"task\" ? node.data.task : undefined;\n              setChosen(task ? { step: task.address.step, scope: task.address.scope } : null);\n            }}\n            onPaneClick={() => setChosen(null)}\n          />\n        </PickContext>\n      </div>\n      {selected?.kind === \"task\" && selected.task && (\n        <aside className=\"neorc-run-graph-panel\" aria-label={`${selected.name} details`}>\n          <div className=\"neorc-run-graph-panel-head\">\n            <strong>\n              {selected.name}\n              {selected.task.address.scope.map(([name, n]) => (\n                <span key={name} className=\"neorc-muted\">\n                  {\" \"}\n                  {name} {n}\n                </span>\n              ))}\n            </strong>\n            <button type=\"button\" onClick={() => setChosen(null)}>\n              Close\n            </button>\n          </div>\n          <TaskDetails task={selected.task} open />\n        </aside>\n      )}\n    </div>\n  );\n}\n\nconst NODE_TYPES: NodeTypes = {\n  task: TaskNode,\n  flow: FlowNode,\n  container: ContainerNode,\n};\n\nfunction TaskNode({ data }: NodeProps<Node<Extract<NodeData, { kind: \"task\" }>>>) {\n  const definition = useContext(DefinitionContext);\n  return (\n    <div className={`neorc-graph-node neorc-graph-task${data.task || definition ? \"\" : \" neorc-graph-none\"}`}>\n      <Handle type=\"target\" position={Position.Top} isConnectable={false} />\n      {!definition && <StatusDot status={data.status} />}\n      <div className=\"neorc-graph-node-text\">\n        <strong>{data.name}</strong>\n        <span className=\"neorc-muted\">{data.handler}</span>\n      </div>\n      {/* Of a run, how it went; of a definition, the queue it is published on. */}\n      <span className=\"neorc-graph-node-when neorc-mono\">\n        {definition ? data.queue : data.duration || data.status}\n      </span>\n      <Handle type=\"source\" position={Position.Bottom} isConnectable={false} />\n    </div>\n  );\n}\n\nfunction FlowNode({ data }: NodeProps<Node<Extract<NodeData, { kind: \"flow\" }>>>) {\n  const { href } = useNav();\n  const definition = useContext(DefinitionContext);\n  return (\n    <div className={`neorc-graph-node neorc-graph-flow${data.run || definition ? \"\" : \" neorc-graph-none\"}`}>\n      <Handle type=\"target\" position={Position.Top} isConnectable={false} />\n      {!definition && <StatusDot status={data.status} />}\n      <div className=\"neorc-graph-node-text\">\n        <strong>{data.name}</strong>\n        {definition ? (\n          <span className=\"neorc-muted\">\n            sub-flow <a href={href({ name: \"flow\", flow: data.flow })}>{data.flow}</a>\n          </span>\n        ) : (\n          <span className=\"neorc-muted\">sub-flow {data.flow}</span>\n        )}\n        {data.run && (\n          <a href={href({ name: \"run\", id: data.run.id })}>run {shortId(data.run.id)}</a>\n        )}\n      </div>\n      {!definition && (\n        <span className=\"neorc-graph-node-when neorc-mono\">{data.duration || data.status}</span>\n      )}\n      <Handle type=\"source\" position={Position.Bottom} isConnectable={false} />\n    </div>\n  );\n}\n\nfunction ContainerNode({\n  data,\n  width,\n  height,\n}: NodeProps<Node<Extract<NodeData, { kind: \"container\" }>>>) {\n  const { loop } = data;\n  const definition = useContext(DefinitionContext);\n  return (\n    <div\n      className={`neorc-graph-container${data.entered || definition ? \"\" : \" neorc-graph-none\"}${loop?.failed ? \" neorc-graph-failed\" : \"\"}`}\n      style={{ width, height }}\n    >\n      <Handle type=\"target\" position={Position.Top} isConnectable={false} />\n      <div className=\"neorc-graph-container-title\">\n        {/* A loop says which iteration it shows where one is picked, below. */}\n        <strong>{data.name}</strong>{\" \"}\n        {!loop && !definition && <span>{data.instance} </span>}\n        <span className=\"neorc-muted\">{data.about}</span>\n      </div>\n      {loop && <IterationPicker name={data.name} loop={loop} />}\n      {/* A switch has an output, which the steps reading it are joined from. */}\n      {data.container === \"switch\" && (\n        <Handle type=\"source\" position={Position.Bottom} isConnectable={false} />\n      )}\n    </div>\n  );\n}\n\n/**\n * Which iteration of a loop its node shows, with the controls to show\n * another, and what the iteration ended with. `nodrag`, `nopan` and\n * `nowheel` keep React Flow from taking the pointer over the controls.\n */\nfunction IterationPicker({ name, loop }: { name: string; loop: LoopShown }) {\n  const pick = useContext(PickContext);\n  const { iterations, shown, outcome } = loop;\n  const last = iterations[iterations.length - 1];\n  const at = iterations.indexOf(shown);\n  const show = (n: number | undefined) => {\n    if (n !== undefined) pick(name, loop.scope, n, n === last);\n  };\n  return (\n    <div className=\"neorc-graph-picker neorc-nodrag neorc-nopan neorc-nowheel\">\n      <button\n        type=\"button\"\n        aria-label={`${name}: previous iteration`}\n        disabled={at <= 0}\n        onClick={() => show(iterations[at - 1])}\n      >\n        ‹\n      </button>\n      <label>\n        iteration{\" \"}\n        <select\n          aria-label={`${name}: iteration shown`}\n          value={shown}\n          onChange={(event) => show(Number(event.target.value))}\n        >\n          {iterations.map((n) => (\n            <option key={n} value={n}>\n              {n}\n            </option>\n          ))}\n        </select>{\" \"}\n        of {last}\n      </label>\n      <button\n        type=\"button\"\n        aria-label={`${name}: next iteration`}\n        disabled={at === iterations.length - 1}\n        onClick={() => show(iterations[at + 1])}\n      >\n        ›\n      </button>\n      {outcome && (\n        <span\n          className={`neorc-graph-outcome ${outcome.failed ? \"neorc-graph-outcome-failed\" : \"neorc-muted\"}`}\n          title={outcome.text}\n        >\n          {outcome.text}\n        </span>\n      )}\n    </div>\n  );\n}\n"],"file":"/neorc-ui/src/components/RunGraph.tsx"}